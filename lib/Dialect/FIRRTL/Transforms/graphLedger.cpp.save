        std::pair<int, int> getStat() {
            int regCount = 0;
            int memCount = 0;
            for (const auto& [_, value] : Nodes) {
                if (value == "DefRegister") {
                    regCount++;
                }
                else if (value == "DefMemory") {
                    memCount++;
                }
            }
            return { regCount, memCount };
        }
    };

